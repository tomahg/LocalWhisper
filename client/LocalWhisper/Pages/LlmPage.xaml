<Page
    x:Class="LocalWhisper.Pages.LlmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="KI-behandling" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12"/>

            <!-- Card 1: On/Off -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid Padding="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE9CE;" FontSize="16"
                              VerticalAlignment="Center" Margin="0,0,14,0"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="KI-behandling" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Forbedre transkribert tekst med en språkmodell"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="EnabledToggle" Grid.Column="2"
                                  OnContent="" OffContent="" MinWidth="0" Margin="16,0,0,0"
                                  Toggled="Enabled_Changed"
                                  VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Card 2: Backend and connection (hidden when disabled) -->
            <Border x:Name="BackendSection"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Visibility="Collapsed">
                <StackPanel>

                    <!-- Backend -->
                    <Grid Padding="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE909;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,14,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Backend" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Hvilken KI-tjeneste som brukes"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                        <ComboBox x:Name="BackendComboBox" Grid.Column="2"
                                  SelectionChanged="Backend_Changed"
                                  MinWidth="160">
                            <ComboBoxItem Content="Ollama (lokal)"/>
                            <ComboBoxItem Content="LM Studio (lokal)"/>
                            <ComboBoxItem Content="OpenAI"/>
                            <ComboBoxItem Content="Claude (Anthropic)"/>
                            <ComboBoxItem Content="Azure OpenAI"/>
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                    <!-- Base URL (hidden for OpenAI and Claude) -->
                    <Grid x:Name="BaseUrlRow" Padding="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE71B;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,14,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Adresse" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Name="BaseUrlDescText"
                                       Text="Base URL til tjenesten"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                        <TextBox x:Name="BaseUrlBox" Grid.Column="2"
                                 MinWidth="220"
                                 LostFocus="BaseUrl_LostFocus"/>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                    <!-- API key -->
                    <Grid Padding="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8D7;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,14,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="API-nøkkel" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Valgfritt for lokale tjenester"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                        <PasswordBox x:Name="ApiKeyBox" Grid.Column="2"
                                     MinWidth="220"
                                     PasswordChanged="ApiKey_Changed"/>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                    <!-- Model -->
                    <Grid Padding="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8EF;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,14,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Modell" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Modellnavn (f.eks. llama3, gpt-4o)"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                        <TextBox x:Name="ModelBox" Grid.Column="2"
                                 MinWidth="160"
                                 LostFocus="Model_LostFocus"/>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                    <!-- System role toggle -->
                    <Grid Padding="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8D3;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,14,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Bruk systemrolle" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Slå av for modeller som kun støtter bruker/assistent (f.eks. Mistral)"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="SystemRoleToggle" Grid.Column="2"
                                      OnContent="" OffContent="" MinWidth="0" Margin="16,0,0,0"
                                      Toggled="SystemRole_Changed"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                    <!-- Timeout -->
                    <Grid Padding="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE916;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,14,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Tidsavbrudd" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Sekunder før forespørselen avbrytes"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                        <NumberBox x:Name="TimeoutBox" Grid.Column="2"
                                   Minimum="5" Maximum="120" SpinButtonPlacementMode="Compact"
                                   ValueChanged="Timeout_Changed"
                                   MinWidth="100"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- Card 3: Prompt (hidden when disabled) -->
            <Border x:Name="PromptsSection"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Visibility="Collapsed">
                <StackPanel>

                    <Grid Padding="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE70F;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,14,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Systemprompt" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Instruksjon som sendes til språkmodellen"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                    <TextBox x:Name="PromptBox"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="80" MaxHeight="200"
                             Margin="16,10" Padding="8"
                             LostFocus="Prompt_LostFocus"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
